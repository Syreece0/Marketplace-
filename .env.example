# Copy this file to ".env" and edit the values. NEVER commit the real .env file.

# --- Core ---------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
# Use True on your own computer while developing. MUST be False in production.
DJANGO_DEBUG=True
# Comma-separated host names, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (with scheme) for HTTPS deployments
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set True once the site is served over HTTPS (turns on secure cookies, HSTS, redirect)
DJANGO_USE_HTTPS=False

# --- Database -----------------------------------------------------------
# "sqlite" (default, fine for development) or "postgresql"
DB_ENGINE=sqlite
DB_NAME=marketplace
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email --------------------------------------------------------------
# Development: prints emails to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Tradewind <no-reply@example.com>
CONTACT_EMAIL=support@example.com

# --- Marketplace --------------------------------------------------------
SITE_NAME=Tradewind
CURRENCY_CODE=NGN
CURRENCY_SYMBOL=₦
MAX_IMAGE_UPLOAD_MB=5

# --- Payments -----------------------------------------------------------
# "test" = built-in clearly-labelled TEST payment (no real money moves).
# A real gateway (e.g. Paystack/Flutterwave) needs a new class in
# orders/gateways.py plus the credentials below. See README.md.
PAYMENT_GATEWAY=test
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# --- Production hosting (Render) ---
# Full PostgreSQL connection string (Render: "Internal Database URL"). Overrides DB_* when set.
DATABASE_URL=
# Cloudinary stores uploaded images. Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Real payments (Paystack) ---
# "test" = simulated payments (default). "paystack" = real payments. See docs/PAYMENTS.md.
PAYMENT_GATEWAY=test
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Share of every sale kept by the marketplace (the Paystack fee is paid out of this share).
COMMISSION_PERCENT=10
